client/.flutter-plugins
client/.flutter-plugins-dependencies
client/.packages
client/build/
client/.pub-cache/
client/.pub/
client/ios/Pods/
client/ios/.symlinks/
client/android/.gradle/
client/android/local.properties
client/android/key.properties
client/android/app/upload-keystore.jks
client/**/GeneratedPluginRegistrant.*
client/coverage/
*.lock

# Gradle / Android (si se genera la carpeta android/)
client/android/app/release/
client/android/app/debug/
.gradle/
local.properties

# Editores / SO
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json.example
*.swp
*.swo
*~
.directory

# Temporal del propio tooling de análisis
/tmp/
*.log
analysis/evidence/apk-*/01-INVENTARIO.md.bak

# ── Excepciones intencionales (SÍ se versionan) ──────────────────────────────
# Media de prueba generada por ESTE repo (barras SMPTE + tono, ffmpeg). Es
# contenido propio, no de terceros: hace que el canal 9001 se reproduzca de
# verdad en el navegador. ~440 KB.
!backend/media/
!backend/media/**
# hls.js vendorizado (Apache-2.0) + su aviso de licencia, para que Chromium
# reproduzca HLS sin depender de una CDN (la preview no tiene red externa).
!client/web/vendor/
!client/web/vendor/**
